---
import manifest from "../../data/slides.json";

export function getStaticPaths() {
  return manifest.slides
    .filter((slide) => slide.slug && Array.isArray(slide.pages) && slide.pages.length > 0)
    .map((slide) => ({
      params: { slug: slide.slug },
      props: { slide },
    }));
}

const { slide } = Astro.props;
const firstPage = slide.pages[0];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171715" />
    <meta name="description" content={`${slide.title} — supurazako Slide Gallery`} />
    <title>{slide.title} — Slide Gallery</title>
    <link rel="stylesheet" href="/viewer.css" />
  </head>
  <body class="viewer-body">
    <main
      class="viewer-shell"
      data-viewer
      data-pages={JSON.stringify(slide.pages)}
      data-title={slide.title}
    >
      <header class="viewer-toolbar">
        <div class="viewer-heading">
          <a class="viewer-back" href="/" aria-label="スライド一覧に戻る">
            <span aria-hidden="true">←</span>
          </a>
          <h1 class="viewer-title">{slide.title}</h1>
        </div>
        <div class="viewer-actions">
          <button
            class="fullscreen-button"
            data-fullscreen
            type="button"
            aria-label="全画面表示"
            aria-pressed="false"
            title="全画面表示"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                data-fullscreen-path
                d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"
              />
            </svg>
          </button>
          <span class="viewer-counter" data-counter aria-live="polite">1 / {slide.pages.length}</span>
        </div>
      </header>

      <section class="viewer-stage" aria-label="スライド">
        <img
          class="viewer-image"
          data-page-image
          src={firstPage}
          alt={`${slide.title} — 1ページ目`}
          draggable="false"
          fetchpriority="high"
        />
        <button
          class="page-button page-button--previous"
          data-previous
          type="button"
          aria-label="前のページ"
          disabled
        >
          <span aria-hidden="true">←</span>
        </button>
        <button
          class="page-button page-button--next"
          data-next
          type="button"
          aria-label="次のページ"
          disabled={slide.pages.length < 2}
        >
          <span aria-hidden="true">→</span>
        </button>
      </section>

      <div
        class="viewer-progress"
        role="progressbar"
        aria-label="スライドの進行状況"
        aria-valuemin="1"
        aria-valuemax={slide.pages.length}
        aria-valuenow="1"
        data-progress
      >
        <span data-progress-fill></span>
      </div>

      <footer class="viewer-footer">
        <p class="viewer-hint">← → or Space</p>
      </footer>
    </main>

    <script>
      const viewer = document.querySelector("[data-viewer]");
      const pages = JSON.parse(viewer.dataset.pages);
      const image = viewer.querySelector("[data-page-image]");
      const counter = viewer.querySelector("[data-counter]");
      const fullscreenButton = viewer.querySelector("[data-fullscreen]");
      const fullscreenPath = fullscreenButton.querySelector("[data-fullscreen-path]");
      const previousButton = viewer.querySelector("[data-previous]");
      const nextButton = viewer.querySelector("[data-next]");
      const progress = viewer.querySelector("[data-progress]");
      const progressFill = viewer.querySelector("[data-progress-fill]");
      const title = viewer.dataset.title;
      const pageFromUrl = Number(new URL(window.location.href).searchParams.get("page"));
      let currentPage = Number.isInteger(pageFromUrl) && pageFromUrl > 0
        ? Math.min(pageFromUrl, pages.length) - 1
        : 0;
      let pointerStart = null;
      let hideControlsTimer;
      let keyboardMode = false;

      function scheduleControlsHide() {
        window.clearTimeout(hideControlsTimer);
        if (keyboardMode && viewer.matches(":focus-within")) return;

        hideControlsTimer = window.setTimeout(() => {
          if (!(keyboardMode && viewer.matches(":focus-within"))) {
            viewer.classList.add("controls-hidden");
          }
        }, 2600);
      }

      function revealControls() {
        viewer.classList.remove("controls-hidden");
        scheduleControlsHide();
      }

      function handlePointerActivity() {
        keyboardMode = false;
        viewer.classList.remove("keyboard-focus");
        revealControls();
      }

      function handleKeyboardActivity() {
        keyboardMode = true;
        if (viewer.matches(":focus-within")) viewer.classList.add("keyboard-focus");
        revealControls();
      }

      function preload(pageIndex) {
        if (pageIndex < 0 || pageIndex >= pages.length) return;
        const nextImage = new Image();
        nextImage.src = pages[pageIndex];
      }

      function showPage(pageIndex) {
        currentPage = Math.max(0, Math.min(pageIndex, pages.length - 1));
        image.src = pages[currentPage];
        image.alt = `${title} — ${currentPage + 1}ページ目`;
        counter.textContent = `${currentPage + 1} / ${pages.length}`;
        previousButton.disabled = currentPage === 0;
        nextButton.disabled = currentPage === pages.length - 1;
        progress.setAttribute("aria-valuenow", String(currentPage + 1));
        progressFill.style.width = `${((currentPage + 1) / pages.length) * 100}%`;

        const url = new URL(window.location.href);
        url.searchParams.set("page", String(currentPage + 1));
        window.history.replaceState(null, "", url);
        preload(currentPage + 1);
        preload(currentPage - 1);
      }

      previousButton.addEventListener("click", () => showPage(currentPage - 1));
      nextButton.addEventListener("click", () => showPage(currentPage + 1));
      if (typeof viewer.requestFullscreen !== "function") {
        fullscreenButton.disabled = true;
        fullscreenButton.title = "このブラウザーでは全画面表示を利用できません";
      }
      fullscreenButton.addEventListener("click", async () => {
        try {
          if (document.fullscreenElement === viewer) {
            await document.exitFullscreen();
          } else if (typeof viewer.requestFullscreen === "function") {
            await viewer.requestFullscreen();
          }
        } catch {
          fullscreenButton.title = "全画面表示を開始できませんでした";
        }
      });
      document.addEventListener("fullscreenchange", () => {
        const isFullscreen = document.fullscreenElement === viewer;
        fullscreenButton.setAttribute("aria-pressed", String(isFullscreen));
        fullscreenButton.setAttribute(
          "aria-label",
          isFullscreen ? "全画面表示を終了" : "全画面表示",
        );
        fullscreenPath.setAttribute(
          "d",
          isFullscreen
            ? "M5 16h3v3h2v-5H5v2zm3-8H5v2h5V5H8v3zm6 11h2v-3h3v-2h-5v5zm2-11V5h-2v5h5V8h-3z"
            : "M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z",
        );
        fullscreenButton.title = isFullscreen ? "全画面表示を終了" : "全画面表示";
        revealControls();
      });
      viewer.addEventListener("pointermove", handlePointerActivity, { passive: true });
      viewer.addEventListener("pointerdown", handlePointerActivity, { passive: true });
      viewer.addEventListener("keydown", handleKeyboardActivity);
      viewer.addEventListener("focusin", () => {
        if (keyboardMode) viewer.classList.add("keyboard-focus");
        revealControls();
      });
      viewer.addEventListener("focusout", () => {
        window.setTimeout(() => {
          if (!viewer.matches(":focus-within")) {
            keyboardMode = false;
            viewer.classList.remove("keyboard-focus");
          }
          scheduleControlsHide();
        }, 0);
      });

      window.addEventListener("keydown", (event) => {
        if (event.target instanceof HTMLElement && event.target.isContentEditable) return;
        if (["INPUT", "TEXTAREA", "SELECT"].includes(event.target?.tagName)) return;
        const focusedControl = event.target.closest?.("a, button");
        if (focusedControl && [" ", "Enter"].includes(event.key)) return;

        if (event.key === "ArrowLeft") {
          event.preventDefault();
          showPage(currentPage - 1);
        } else if (["ArrowRight", " ", "Enter"].includes(event.key)) {
          event.preventDefault();
          showPage(currentPage + 1);
        } else if (event.key === "Escape") {
          if (document.fullscreenElement) {
            event.preventDefault();
            void document.exitFullscreen();
          } else {
            window.location.assign("/");
          }
        }
      });

      viewer.querySelector(".viewer-stage").addEventListener("pointerdown", (event) => {
        pointerStart = { x: event.clientX, y: event.clientY };
      });

      viewer.querySelector(".viewer-stage").addEventListener("pointerup", (event) => {
        if (!pointerStart) return;
        const deltaX = event.clientX - pointerStart.x;
        const deltaY = event.clientY - pointerStart.y;
        pointerStart = null;
        if (Math.abs(deltaX) < 56 || Math.abs(deltaX) < Math.abs(deltaY)) return;
        showPage(currentPage + (deltaX < 0 ? 1 : -1));
      });

      viewer.querySelector(".viewer-stage").addEventListener("pointercancel", () => {
        pointerStart = null;
      });

      showPage(currentPage);
      revealControls();
    </script>
  </body>
</html>
